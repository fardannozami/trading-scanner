# Notification channels: telegram, whatsapp, both, or telegram,whatsapp
ALERT_CHANNELS=telegram

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username
# Legacy fallback; paired chats are preferred when any exist.
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_PAIR_CODE_TTL_MINUTES=10
TELEGRAM_PAIR_MAX_ATTEMPTS=5

# WhatsApp via separate Go service using whatsmeow (Linked Devices)
WHATSAPP_SERVICE_URL=http://127.0.0.1:8787
WHATSAPP_SERVICE_TOKEN=generate_a_long_random_secret
WHATSAPP_LISTEN_ADDR=127.0.0.1:8787
WHATSAPP_PHONE=+6281234567890
WHATSAPP_RECIPIENT_JID=6281234567890@s.whatsapp.net
WHATSAPP_SESSION_DB=whatsmeow.db

# MetaTrader 5
MT5_LOGIN=123456
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Server

# Scanner settings
SCAN_INTERVAL=60
ALERT_COOLDOWN_MINUTES=60

# Risk management
MAX_RISK_PER_TRADE=1.0
MAX_DAILY_DRAWDOWN=3.0
MAX_WEEKLY_DRAWDOWN=6.0
MAX_CONSECUTIVE_LOSSES=3
# Skip setups whose stop is more than N x ATR from entry (0 = no cap)
MAX_SL_ATR=2.0

# News filter
NEWS_FILTER_ENABLED=true
NEWS_BLOCK_MINUTES_BEFORE=30
NEWS_BLOCK_MINUTES_AFTER=15

# Paper trading (virtual positions + strategy win rate)
PAPER_TRADING_ENABLED=true
PAPER_LOT=0.01
PAPER_TP_LEVEL=tp1
PAPER_MAX_HOLD_HOURS=168
PAPER_ALLOW_STACKING=false

# Live trading (REAL orders). Leaving the defaults below keeps live execution
# off. To arm it you must set all three:
#   LIVE_TRADING_ENABLED=true
#   LIVE_TRADING_DRY_RUN=false
#   LIVE_CONFIRMATION=YES
LIVE_TRADING_ENABLED=false
LIVE_TRADING_DRY_RUN=true
LIVE_CONFIRMATION=
LIVE_MIN_GRADE=A+
LIVE_LOT_MODE=risk
LIVE_FIXED_LOT=0.01
LIVE_TP_LEVEL=tp1
LIVE_MAGIC=20261116
LIVE_DEVIATION=20
LIVE_MAX_SPREAD_POINTS=50
LIVE_MAX_OPEN_POSITIONS=1
LIVE_MAX_DAILY_TRADES=5
LIVE_COMMENT=Scanner

# Database
DB_PATH=trading_scanner.db
